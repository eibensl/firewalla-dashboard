# This network's settings. Copy this file to config/settings.env and fill it
# in (the setup page will do this for you once it exists), then restart the
# dashboard. One NAME=value per line, no quotes; lines starting with # are
# notes. Anything not listed here is ignored.

# Your Firewalla router's address (usually your network's gateway).
FIREWALLA_SSH_HOST=192.168.1.1
# The router's model as Firewalla names it, e.g. Firewalla Gold Pro (only a
# Gold Pro gets its own port numbering; empty: ports shown by their names).
FIREWALLA_ROUTER_MODEL=
# How often the router's state is read, in seconds (5 to 60).
FIREWALLA_ROUTER_POLL_SECONDS=5

# Your network's name: the menu shows "<name> Network".
FIREWALLA_SITE_NAME=My
# Your local time as a rule, e.g. US Central: CST6CDT,M3.2.0,M11.1.0
# (empty: UTC).
TZ=

# Your Firewalla MSP address, e.g. https://xxxxxx.firewalla.net (empty: no
# MSP). Its READ-ONLY token goes in config/msp_api_token.
FIREWALLA_MSP_URL=

# The address email links point to, e.g. http://192.168.1.10:8180/next
FIREWALLA_DASHBOARD_URL=
# Extra names the dashboard answers to besides IP addresses and local names
# (comma list), e.g. a DNS name you gave the NAS.
FIREWALLA_ALLOWED_HOSTS=

# Usually empty: other copies of the dashboard ("Name=address", comma list),
# a Synology High Availability pair ("<shared address>=<MAC>,<MAC>"), and
# on (compress the router connection) for a router reached over a VPN.
FIREWALLA_SITE_OTHERS=
FIREWALLA_HA_PAIRS=
FIREWALLA_SSH_COMPRESS=

# Which Claude answers Ask Claude: sonnet (better answers, the default) or haiku
# (about a twentieth of the cost). The setup page's step 6 sets it.
#FIREWALLA_CLAUDE_MODEL=sonnet
